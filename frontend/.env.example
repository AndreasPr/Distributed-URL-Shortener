# Browser-visible settings only. Never use a service-role key.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_EMAIL_AUTH=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Isolated LocalAuth demo only; never enable on a public deployment.
NEXT_PUBLIC_LOCAL_AUTH=false
# Sample data is always scoped to /demo; NEXT_PUBLIC_DEMO_MODE is obsolete.
