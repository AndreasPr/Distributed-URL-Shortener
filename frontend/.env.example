# Frontend local API configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional override: omit for automatic Vercel production demo / local real API.
# NEXT_PUBLIC_DEMO_MODE=true

# Only enable for an isolated AUTH_MODE=local backend. make demo sets this.
NEXT_PUBLIC_LOCAL_AUTH=false

# Reserved for the future browser Supabase login UI; currently unused.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
