# Copy to .env. These are placeholders, not usable deployment credentials.
# Use URL-safe DB credentials (e.g. randomly generated hex) because Compose
# assembles DB_URL. Existing PostgreSQL/Grafana volumes retain initial credentials.
POSTGRES_USER=replace_with_local_db_user
POSTGRES_PASSWORD=replace_with_url_safe_local_db_password
POSTGRES_DB=url_db
GRAFANA_ADMIN_USER=replace_with_local_grafana_user
GRAFANA_ADMIN_PASSWORD=replace_with_local_grafana_password
# Host-run backend: set credentials to the SAME values as above.
# Compose supplies its own internal DB_URL and ignores this host-only value.
DB_URL=postgresql://replace_with_local_db_user:replace_with_url_safe_local_db_password@localhost:5433/url_db
# Leave DATABASE_URL unset: it takes precedence over DB_URL in the app.
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used for direct Python execution; Compose profiles select the adapter explicitly.
EVENT_BUS=kafka
EVENT_TOPIC=url-events
EVENT_DLQ_TOPIC=url-events-dlq
EVENT_CONSUMER_GROUP=analytics-group
EVENT_BATCH_SIZE=100
EVENT_FLUSH_INTERVAL=5
EVENT_QUEUE_SIZE=1000
EVENT_RETRY_BACKOFF=0.25
EVENT_CLAIM_IDLE_MS=60000
EVENT_METRICS_PORT=8001

# Token buckets: capacity in requests, refill in tokens per second.
WRITE_RATE_CAPACITY=20
WRITE_RATE_REFILL=1
REDIRECT_RATE_CAPACITY=120
REDIRECT_RATE_REFILL=10
# Comma-separated exact proxy IPs/CIDRs. Empty means ignore forwarded headers.
TRUSTED_PROXIES=
# 0 exposes /metrics on the API port; Kubernetes overrides with internal port 8002.
METRICS_PORT=0

# Production requires explicit exact browser origins; wildcards are rejected.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=16384

# Compose containers use Jaeger; host-run processes use localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# LLM layer (not yet connected to redirects or event handlers).
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_CONCURRENCY=2
LLM_DAILY_BUDGET=100
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=0.25
LLM_MAX_OUTPUT_TOKENS=512
